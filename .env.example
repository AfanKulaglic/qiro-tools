# ----------------------------------------------------------------------------
# LinkQR Tools — environment variables
# Copy this file to ".env" and fill in your values.
# Vite only exposes variables prefixed with VITE_ to the client.
# (Firebase web keys are public by design — security is enforced by RTDB rules.)
# ----------------------------------------------------------------------------

# Firebase web app config (Project settings → General → Your apps → SDK setup)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# ImgBB — free image hosting used for storage (https://api.imgbb.com → Get API key)
VITE_IMGBB_API_KEY=your_imgbb_api_key

# Optional: short-link subdomain. If set, generated links use this origin:
#   https://go.yourdomain.com/<slug>
# If left empty, links fall back to window.location.origin + "/s/<slug>"
VITE_SHORT_DOMAIN=
